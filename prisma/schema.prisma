generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessType {
  LOCAL_BUSINESS
  PORTFOLIO
}

model Business {
  id               String       @id @default(cuid())
  username         String       @unique
  phone            String
  whatsappId       String?
  type             BusinessType @default(LOCAL_BUSINESS)
  status           String       @default("pending") // pending, trial, active, suspended, cancelled
  activationCode   String?
  trialEndsAt      DateTime
  createdAt        DateTime     @default(now())
  isDeleted        Boolean      @default(false)
  deletedAt        DateTime?
  legalAcceptedAt  DateTime?
  profile          Profile?
  portfolio        Portfolio?
  geminiDraft      GeminiDraft?
  subscription     Subscription?
  updates          ProfileUpdate[]
  pageViews        PageView[]
}

model Profile {
  id            String   @id @default(cuid())
  businessId    String   @unique
  name          String
  city          String
  services      Json
  trustReason   String
  contactPhone  String
  images        String[]
  generatedHtml String?
  content       Json?
  backupContent Json?
  seoTitle      String?
  seoDesc       String?
  template      String   @default("trades")
  vibe          String   @default("modern")
  business      Business @relation(fields: [businessId], references: [id])
}

model Portfolio {
  id            String   @id @default(cuid())
  businessId    String   @unique
  name          String
  profession    String
  bio           String
  location      String?
  email         String?
  website       String?
  socialLinks   Json     @default("{}")  // { linkedin, github, instagram, twitter }
  skills        String[]
  avatarUrl     String?
  content       Json?                    // generated page content blob
  generatedHtml String?
  seoTitle      String?
  seoDesc       String?
  template      String   @default("modern")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  business      Business  @relation(fields: [businessId], references: [id])
  uploads       Upload[]
}

model Upload {
  id          String   @id @default(cuid())
  portfolioId String
  filename    String
  url         String
  mimeType    String
  sizeBytes   Int
  category    String   @default("general") // avatar, project, document, general
  createdAt   DateTime @default(now())
  portfolio   Portfolio @relation(fields: [portfolioId], references: [id])
}

model Subscription {
  id                   String    @id @default(cuid())
  businessId           String    @unique
  stripeCustomerId     String
  stripeSubscriptionId String?
  ibanLast4            String?
  status               String
  currentPeriodEnd     DateTime?
  business             Business  @relation(fields: [businessId], references: [id])
}

model ProfileUpdate {
  id         String   @id @default(cuid())
  businessId String
  rawMessage String
  type       String
  processed  Boolean  @default(false)
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
}

model PageView {
  id         String   @id @default(cuid())
  businessId String
  createdAt  DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id])
}

model OnboardingSession {
  id        String   @id @default(cuid())
  phone     String   @unique
  step      String   // 'type' | 'loc:name' | 'loc:city' | 'port:name' | 'port:profession' | 'port:template'
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DraftStatus {
  PENDING
  APPROVED
  REJECTED
}

model GeminiDraft {
  id         String      @id @default(cuid())
  businessId String      @unique
  business   Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  payload    Json        // Aquí guardaremos la respuesta cruda de Gemini
  status     DraftStatus @default(PENDING)
  createdAt  DateTime    @default(now())
  expiresAt  DateTime?   // Para futura limpieza de borradores abandonados
}
